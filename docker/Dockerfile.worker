# Tern worker.
#
# The worker checks out repositories with git and runs sandboxed npm commands, so
# git and a toolchain must be present. It runs as a non-root user and owns a
# dedicated workspace volume.
FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++ git
COPY package.json package-lock.json* tsconfig.base.json tsconfig.build.json ./
COPY packages ./packages
COPY apps ./apps
COPY tests ./tests
COPY demo ./demo
RUN npm install --ignore-scripts \
 && npm run db:generate \
 && npm run build:packages

FROM node:20-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache git tini \
 && addgroup -S tern && adduser -S tern -G tern \
 && mkdir -p /var/lib/tern/workspaces && chown -R tern:tern /var/lib/tern
COPY --from=build --chown=tern:tern /app /app
USER tern
ENV NODE_ENV=production WORKSPACE_ROOT=/var/lib/tern/workspaces
# tini forwards SIGTERM so the worker's graceful drain actually runs.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/worker/dist/index.js"]
