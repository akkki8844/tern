# Capibara web application (dashboard, webhook endpoint, OAuth, health checks).
FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json* tsconfig.base.json tsconfig.build.json ./
COPY packages ./packages
COPY apps ./apps
COPY tests ./tests
COPY demo ./demo
RUN npm install --ignore-scripts \
 && npm run db:generate \
 && npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache tini && addgroup -S capibara && adduser -S capibara -G capibara
COPY --from=build --chown=capibara:capibara /app /app
USER capibara
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "start", "-w", "@capibara/web"]
