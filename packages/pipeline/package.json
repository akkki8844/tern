    "@capibara/llm": "*",
    "@capibara/migration-engine": "*",
    "@capibara/openapi": "*",
    "@capibara/sandbox": "*",
    "@capibara/scanner": "*",
    "@capibara/shared": "*",
    "@capibara/workspace": "*"
  },
  "devDependencies": {}
}
