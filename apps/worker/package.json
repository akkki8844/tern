{
  "name": "@tern/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "test:watch": "node --watch --test dist/**/*.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "@tern/shared": "*",
    "@tern/db": "*",
    "@tern/openapi": "*",
    "@tern/scanner": "*",
    "@tern/migration-engine": "*",
    "@tern/sandbox": "*",
    "@tern/llm": "*",
    "@tern/github": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
