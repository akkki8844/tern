{
  "name": "@capibara/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "demo": "CAPIBARA_MODE=demo node dist/demo.js",
    "typecheck": "tsc -b",
    "test": "LOG_LEVEL=silent node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@capibara/db": "*",
    "@capibara/github": "*",
    "@capibara/jobs": "*",
    "@capibara/llm": "*",
    "@capibara/migration-engine": "*",
    "@capibara/openapi": "*",
    "@capibara/pipeline": "*",
    "@capibara/sandbox": "*",
    "@capibara/scanner": "*",
    "@capibara/shared": "*",
    "@capibara/workspace": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
