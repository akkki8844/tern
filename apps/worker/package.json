{
  "name": "@tern/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "demo": "TERN_MODE=demo node dist/demo.js",
    "typecheck": "tsc -b",
    "test": "LOG_LEVEL=silent node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tern/db": "*",
    "@tern/github": "*",
    "@tern/jobs": "*",
    "@tern/llm": "*",
    "@tern/migration-engine": "*",
    "@tern/openapi": "*",
    "@tern/pipeline": "*",
    "@tern/sandbox": "*",
    "@tern/scanner": "*",
    "@tern/shared": "*",
    "@tern/workspace": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
