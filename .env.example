# ---------------------------------------------------------------------------
# Capibara configuration
#
# Every variable Capibara reads is listed here and validated at startup by
# packages/shared/src/config.ts. See docs/environment.md for the full reference.
# ---------------------------------------------------------------------------

# --- Core --------------------------------------------------------------------
NODE_ENV=development
# 'real' (default) or 'demo'. Demo mode swaps every external provider for an
# in-memory one; nothing leaves the process.
CAPIBARA_MODE=real
LOG_LEVEL=info
# Human-readable log output. Never enabled automatically in production.
LOG_PRETTY=true
SERVICE_NAME=capibara

# --- Database (required) -------------------------------------------------------
DATABASE_URL=postgresql://capibara:capibara@localhost:5432/capibara
DATABASE_POOL_SIZE=10

# --- GitHub App (required in production unless CAPIBARA_MODE=demo) -----------------
# The App is the only credential allowed to touch repositories.
GITHUB_APP_ID=
# PEM text, PEM with literal \n escapes, or a base64-encoded PEM.
GITHUB_PRIVATE_KEY=
# Minimum 16 characters. Must match the secret configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# --- GitHub OAuth (optional, user sign-in only) --------------------------------
# Never used for repository access. Requires SESSION_SECRET when enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Minimum 32 characters.
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# --- Fireworks AI (optional) ---------------------------------------------------
# When unset, the AI fallback is disabled and migrations stay deterministic.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
FIREWORKS_TIMEOUT_MS=60000
FIREWORKS_MAX_ATTEMPTS=3
FIREWORKS_MAX_PROMPT_CHARS=24000

# --- Worker --------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_DURATION_MS=60000
# Must be smaller than WORKER_LEASE_DURATION_MS.
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Defaults to ${hostname}-${pid}.
WORKER_ID=

# --- Workspaces ----------------------------------------------------------------
# Absolute path that contains one isolated directory per job.
WORKSPACE_ROOT=/tmp/capibara-workspaces
WORKSPACE_MAX_BYTES=536870912

# --- Sandbox -------------------------------------------------------------------
SANDBOX_TIMEOUT_MS=300000
SANDBOX_MEMORY_MB=2048
SANDBOX_CPU_LIMIT=2

# --- Demo ----------------------------------------------------------------------
CAPIBARA_DEMO_REPO_PATH=

# --- Optional ------------------------------------------------------------------
# At-rest encryption key for future stored provider tokens. Minimum 32 characters.
ENCRYPTION_KEY=

# --- Tests ---------------------------------------------------------------------
# When set, the multi-connection job concurrency suite runs against this database.
# CAPIBARA_TEST_DATABASE_URL=postgresql://capibara:capibara@localhost:5432/capibara_test
