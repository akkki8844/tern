
{
  "name": "@tern/tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test packages/*/*.test.ts packages/*/**/*.test.ts",
    "test:unit": "node --test --test-reporter=spec packages/*/*.test.ts packages/*/**/*.test.ts",
    "test:openapi": "node --test packages/openapi/**/*.test.ts",
    "test:scanner": "node --test packages/scanner/**/*.test.ts",
    "test:migration": "node --test packages/migration-engine/**/*.test.ts",
    "test:sandbox": "node --test packages/sandbox/**/*.test.ts",
    "test:github": "node --test packages/github/**/*.test.ts",
    "test:llm": "node --test packages/llm/**/*.test.ts",
    "test:integration": "node --test tests/integration/**/*.test.ts"
  }
}
