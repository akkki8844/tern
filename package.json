{
  "name": "capibara",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/jobs",
    "packages/workspace",
    "packages/github",
    "packages/llm",
    "packages/openapi",
    "packages/scanner",
    "packages/migration-engine",
    "packages/sandbox",
    "packages/pipeline",
    "tests",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "postinstall": "npm run db:generate || node scripts/prisma-offline-note.mjs",
    "build": "npm run build:packages && npm run build:web",
    "build:packages": "tsc -b tsconfig.build.json",
    "build:web": "npm run build -w @capibara/web",
    "clean": "tsc -b tsconfig.build.json --clean && npm run clean --workspaces --if-present",
    "typecheck": "tsc -b tsconfig.build.json && npm run typecheck -w @capibara/web",
    "lint": "eslint . --ext .ts,.tsx,.mts,.cts && npm run lint -w @capibara/web",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w @capibara/web\" \"npm run dev -w @capibara/worker\"",
    "dev:web": "npm run dev -w @capibara/web",
    "dev:worker": "npm run dev -w @capibara/worker",
    "start:worker": "npm run start -w @capibara/worker",
    "start": "npm run start -w @capibara/web",
    "db:generate": "npm run db:generate -w @capibara/db",
    "db:migrate": "npm run db:migrate -w @capibara/db",
    "db:deploy": "npm run db:deploy -w @capibara/db",
    "db:studio": "npm run db:studio -w @capibara/db",
    "db:seed": "npm run db:seed -w @capibara/db",
    "db:reset": "npm run db:reset -w @capibara/db",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "config:check": "node --experimental-strip-types scripts/check-config.ts",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ci:lint": "npm run lint",
    "ci:typecheck": "npm run typecheck",
    "ci:test": "npm run test",
    "ci:build": "npm run build",
    "demo": "npm run demo -w @capibara/worker"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
