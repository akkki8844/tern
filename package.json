{
  "name": "tern",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "dev": "concurrently 'npm run dev -w apps/web' 'npm run dev -w apps/worker'",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "start": "npm run start -w apps/web",
    "bootstrap": "npm install && npm run db:generate && npm run build",
    "postinstall": "npm run db:generate",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:deploy": "npm run db:deploy -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "db:reset": "npm run db:reset -w packages/db",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:build": "docker-compose -f docker/docker-compose.yml build",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ci:lint": "npm run lint",
    "ci:typecheck": "npm run typecheck",
    "ci:test": "npm run test",
    "ci:build": "npm run build",
    "demo": "npm run demo:validate -w apps/worker",
    "demo:diff": "node --experimental-strip-types scripts/demo/diff.ts",
    "demo:scan": "node --experimental-strip-types scripts/demo/scan.ts",
    "demo:migrate": "node --experimental-strip-types scripts/demo/migrate.ts",
    "demo:sandbox": "node --experimental-strip-types scripts/demo/sandbox.ts",
    "demo:pr": "node --experimental-strip-types scripts/demo/create-pr.ts",
    "demo:validate": "node --experimental-strip-types scripts/demo/validate.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "concurrently": "^9.1.0",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}